# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH: Optional override for base path (vite.config.ts automatically uses '/' in dev and '/BUSN9155_Google/' on build).
# VITE_BASE_PATH="/BUSN9155_Google/"

# VITE_FORM_ENDPOINT: Static-site form service endpoint (e.g., https://formspree.io/f/your_form_id).
# Leave empty until configured; the enquiry form will clearly explain that live submission is not yet connected.
VITE_FORM_ENDPOINT=""

# VITE_GA4_MEASUREMENT_ID: Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX).
# Leave empty until configured; GA4 remains disabled until a valid G- ID is provided.
VITE_GA4_MEASUREMENT_ID=""
